# Copy to .env.local (git-ignored) and fill in. Never commit a real key: the repo is public.
# Every variable is optional. With no key, run offline mode (PROVIDER_MODE=local, below).

# Hosted mode (the default when PROVIDER_MODE is not set): Mistral for speech-to-text and
# intent extraction. Leave empty if you have no key.
MISTRAL_API_KEY=

# Offline mode (decisions 83 and 194): needs no key. The coordinator calls nothing outside this
# computer. Speech-to-text runs through whisper-server (`npm run stt`), extraction through Ollama.
# Setup: docs/setup.md, part 3.
# PROVIDER_MODE=local
# LOCAL_EXTRACT_MODEL=ministral-3:3b
# OLLAMA_URL=http://127.0.0.1:11434
# WHISPER_URL=http://127.0.0.1:3118

# Optional model overrides (defaults: voxtral-mini-transcribe-3, mistral-small-latest).
# MISTRAL_STT_MODEL=
# Speakers told apart in a clip (decision 175), on by default; 0 turns it off.
# MISTRAL_STT_DIARIZE=0
# MISTRAL_EXTRACT_MODEL=

# Optional: extraction fallback when MISTRAL_API_KEY is absent (speech-to-text still needs Mistral).
# FEATHERLESS_API_KEY=
# FEATHERLESS_MODEL=

# Optional: another Overpass server for `npm run gazetteer` when the main one is overloaded.
# OVERPASS_URL=

# Ukrainian voice (decisions 45 and 50): bundle the 77 MB model into the build; allow a
# browser download from Hugging Face (US-hosted, off by default).
# TTS_BUNDLE_MODEL=1
# NEXT_PUBLIC_TTS_HF_FALLBACK=1
