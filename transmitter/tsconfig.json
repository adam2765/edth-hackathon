{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      // whisper.rn's package.json has no "." entry in its exports map, which TypeScript
      // (unlike Metro) refuses to fall back from. Point it at the package's type file.
      "whisper.rn": ["./node_modules/whisper.rn/lib/typescript/index.d.ts"]
    }
  }
}
